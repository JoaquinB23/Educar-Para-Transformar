    "lint": "node scripts/lint.cjs",
    "format:check": "prettier --check package.json ../eslint.config.mjs jest.config.cjs cypress.config.cjs tests/**/*.js cypress/**/*.js ../docs/TP_Unidad5.md ../.github/pull_request_template.md ../.github/workflows/ci.yml",
