# Copiá este archivo a .env y completá con tus credenciales de Firebase
# cp .env.example .env

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Firebase Admin (backend). Obtener desde la clave de cuenta de servicio.
FIREBASE_CLIENT_EMAIL=
# Pegar la clave privada con \n escapados en una sola línea.
FIREBASE_PRIVATE_KEY=
